# No secrets required for Milestone 1 (CSV/sample data only, paper trading only).
# This file documents non-secret local configuration only. Never commit a real .env.

SMART_TRADER_DB_PATH=data/paper_trading.db
SMART_TRADER_STARTING_CASH=100000

# --- Groww (READ-ONLY market data; paper trading only, no orders are ever placed) ---
# Copy this file to .env (git-ignored) and fill in ONE of the three options. Never paste
# these values into chat, commits, screenshots or logs. Check with: python -m app.cli check-env
# Option 1: access token (generated on Groww's Trading APIs page; expires daily)
GROWW_ACCESS_TOKEN=
# Option 2: API key + secret (needs daily approval on Groww)
GROWW_API_KEY=
GROWW_API_SECRET=
# Option 3: TOTP
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
